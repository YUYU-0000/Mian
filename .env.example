# 部署配置模板，复制为 .env 使用；已有进程环境变量优先。
# 相对路径统一按仓库根目录解析。
MIAN_DATA_DIR=server/data
MIAN_RUNTIME_DIR=.mian-runtime
MIAN_PORT=5173
MIAN_HOST=0.0.0.0
MIAN_PUBLIC_ORIGIN=https://mian.crab-bless.com
# Defaults to ~/MianWorkspace on either platform.
# MIAN_WORKSPACE_DIR=C:/Users/ASUS/MianWorkspace
# Defaults to ~/Desktop/Mian备份/每日 on Windows, ~/MianBackups/daily on Linux.
# MIAN_BACKUP_DIR=C:/Users/ASUS/Desktop/Mian备份/每日
# Use an absolute executable path when a scheduled task has a different PATH.
# MIAN_CODEX_BIN=C:/Users/ASUS/AppData/Local/Programs/OpenAI/Codex/bin/codex.exe
# MIAN_CODEX_HOME=C:/Users/ASUS/.codex
# MIAN_CLOUDFLARED_BIN=C:/Program Files (x86)/cloudflared/cloudflared.exe
# MIAN_TUNNEL_CONFIG=C:/Users/ASUS/.cloudflared/mian.yml

